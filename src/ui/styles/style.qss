
/* =========================
   MAIN WINDOW
========================= */

QMainWindow {
    background-color: #101318;
}

QWidget#content {
    background-color: #101318;
}


/* =========================
   SIDEBAR
========================= */

QFrame#sidebar {
    background-color: #171B22;
    border-right: 1px solid #292F3A;
}

QLabel#logo {
    color: #F0F3F8;
    font-size: 23px;
    font-weight: 800;
}

QLabel#section_label {
    color: #707D90;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#version {
    color: #667386;
    font-size: 9px;
}


/* =========================
   NAVIGATION
========================= */

QPushButton#nav_button,
QPushButton#active_nav {
    text-align: left;
    padding: 12px;
    border-radius: 7px;
    border: none;
    font-size: 13px;
}

QPushButton#nav_button {
    color: #9BA7B8;
    background: transparent;
}

QPushButton#nav_button:hover {
    background: #252D39;
    color: white;
}

QPushButton#active_nav {
    color: white;
    background: #263B5C;
    border: 1px solid #345889;
    font-weight: 600;
}


/* =========================
   PAGE HEADERS
========================= */

QLabel#page_title {
    color: #F0F3F8;
    font-size: 24px;
    font-weight: 700;
}

QLabel#system_status {
    color: #67C99B;
    font-size: 10px;
    font-weight: 700;
}

QLabel#description {
    color: #98A7BB;
    font-size: 12px;
}

QLabel#footer {
    color: #687589;
    font-size: 10px;
}


/* =========================
   HOME PAGE
========================= */

QFrame#welcome {
    background: #192638;
    border: 1px solid #294365;
    border-radius: 12px;
}

QLabel#welcome_title {
    color: #F4F7FC;
    font-size: 25px;
    font-weight: 700;
}

QPushButton#start_button {
    background: #3479E8;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 12px 18px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#start_button:hover {
    background: #478BFA;
}


/* =========================
   STATISTICS CARDS
========================= */

QFrame#card,
QFrame#panel {
    background: #191E27;
    border: 1px solid #2A303B;
    border-radius: 9px;
}

QLabel#card_heading {
    color: #8491A4;
    font-size: 10px;
    font-weight: 700;
}

QLabel#card_value {
    color: #F0F3F8;
    font-size: 21px;
    font-weight: 700;
}

QLabel#card_description {
    color: #778498;
    font-size: 11px;
}


/* =========================
   SUBJECTS PAGE
========================= */

QLineEdit#subject_search {
    background: #191E27;
    color: #F0F3F8;
    border: 1px solid #2A303B;
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 12px;
}

QLineEdit#subject_search:focus {
    border: 1px solid #3479E8;
}

QScrollArea#subject_scroll {
    background: transparent;
    border: none;
}

QWidget#subject_container {
    background: transparent;
}


/* =========================
   SUBJECT CARDS
========================= */

QFrame#subject_card {
    background: #191E27;
    border: 1px solid #2A303B;
    border-radius: 10px;
}

QFrame#subject_card:hover {
    background: #222B38;
    border: 1px solid #46566D;
}

QFrame#subject_card_selected {
    background: #1B2636;
    border: 1px solid #3479E8;
    border-radius: 10px;
}

QLabel#subject_card_title {
    color: #F0F3F8;
    font-size: 15px;
    font-weight: 600;
}

QLabel#subject_card_description {
    color: #8491A4;
    font-size: 11px;
    padding-left: 4px;
}

QFrame#subject_separator {
    background: #303B4B;
    border: none;
}

QLabel#empty_subjects {
    color: #778498;
    font-size: 13px;
    min-height: 180px;
}


/* =========================
   BUTTONS
========================= */

QPushButton#add_subject_button {
    background: #3479E8;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#add_subject_button:hover {
    background: #478BFA;
}

QPushButton#rename_subject_button {
    background: #29384D;
    color: #B9C9E0;
    border: 1px solid #394D68;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 11px;
}

QPushButton#rename_subject_button:hover {
    background: #354B68;
}

QPushButton#delete_subject_button {
    background: #38272D;
    color: #E58B8B;
    border: 1px solid #54333B;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 11px;
}

QPushButton#delete_subject_button:hover {
    background: #493039;
}


/* =========================
   STATUS BAR
========================= */

QStatusBar {
    color: #98A7BB;
    background: #171B22;
}
